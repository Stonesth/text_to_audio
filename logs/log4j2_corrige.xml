<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <property name="filePattern">${date:yyyy-MM-dd-HH_mm_ss}</property>
        <property name="filePatternTF-5599">${date:yyyy-MM-dd-HH_mm}</property>
        <property name="filePatternTF-CASF410B">${date:yyyy-MM-dd-HH_mm}</property>
    </Properties>
    
    <Appenders>
        <File name="file" fileName="../logs/application${filePattern}.log" append="false">
            <PatternLayout pattern="%d{ABSOLUTE} %-5p %c:%L - %m%n"/>
        </File>
        
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{ABSOLUTE} %-5p %c:%L - %m%n"/>
        </Console>
        
        <File name="SQLLog" fileName="../logs/sql${filePattern}.log">
            <PatternLayout pattern="%d{ABSOLUTE} %-5p %c:%L - %m%n"/>
        </File>
        
        <!-- Appender pour TF-5599 avec configuration de suppression corrigée -->
        <RollingFile name="TF-5599" fileName="../logs/TF-5599/TF-5599.log"
                     filePattern="../logs/TF-5599/TF-5599-%d{yyyy-MM-dd-HH-mm}-%i.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm} %-5p %c{1}:%L - %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="5" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <!-- Règle de suppression en dehors de Policies -->
            <DefaultRolloverStrategy max="20">
                <Delete basePath="../logs/TF-5599" maxDepth="1" maxAge="2d" deleteEmptyDirectories="true">
                    <IfFileName glob="TF-5599-*.log"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
        
        <!-- Appender pour I2D160L avec configuration de suppression corrigée -->
        <RollingFile name="I2D160L" fileName="../logs/I2D/I2D160/I2D160L.log"
                     filePattern="../logs/I2D/I2D160/I2D160L-%d{yyyy-MM-dd-HH-mm}-%i.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm} %-5p %c{1}:%L - %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="5" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <!-- Règle de suppression en dehors de Policies -->
            <DefaultRolloverStrategy max="20">
                <Delete basePath="../logs/I2D/I2D160" maxDepth="1" maxAge="2d" deleteEmptyDirectories="true">
                    <IfFileName glob="I2D160L-*.log"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
        
        <!-- Appender pour I2D160N avec configuration de suppression corrigée -->
        <RollingFile name="I2D160N" fileName="../logs/I2D/I2D160/I2D160N.log"
                     filePattern="../logs/I2D/I2D160/I2D160N-%d{yyyy-MM-dd-HH-mm}-%i.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm} %-5p %c{1}:%L - %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="5" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <!-- Règle de suppression en dehors de Policies -->
            <DefaultRolloverStrategy max="20">
                <Delete basePath="../logs/I2D/I2D160" maxDepth="1" maxAge="2d" deleteEmptyDirectories="true">
                    <IfFileName glob="I2D160N-*.log"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>
    
    <Loggers>
        <!--  work-around for internal bug -->
        <Logger name="innowake.mee.natural.runtime.sysout" level="info"/>
        <Logger name="innowake.mee.base.execption.rethrow" level="off"/>

        <Logger name="org.springframework" level="info"/>
        <Logger name="innowake.mee.natural.api.move" level="off"/>

        <!-- Specific Logger -->
        <Logger name="innowake.lib.license" level="error"/>
        <Logger name="innowake.mee.base.memory.layout" level="warn"/>

        <!-- Performance Logger -->
        <Logger name="prof" level="off"/>
        <Logger name="innowake.mee.natural.runtime.performance" level="off"/>
        <Logger name="prof.mee.runtime.cobol.api" level="off"/>
        <Logger name="com.innowake.gen" level="trace"/>

        <!-- TF-5599 -->
        <Logger name="nn.fliba.gen.procedures" level="debug" additivity="false">
            <AppenderRef ref="TF-5599"/>
        </Logger>
        <Logger name="nn.fliba.gen.batchmanager" level="debug" additivity="false">
            <AppenderRef ref="TF-5599"/>
        </Logger>

        <!-- I2D160L => CASF410B -->
        <Logger name="nn.fliba.gen.procedures.Casf410bCoda2Inlezen" level="debug" additivity="false">
            <AppenderRef ref="I2D160L"/>
        </Logger>
        <Logger name="nn.fliba.gen.batchmanager.CASF410B" level="debug" additivity="false">
            <AppenderRef ref="I2D160L"/>
        </Logger>

        <!-- I2D160N => CASF415B -->
        <Logger name="nn.fliba.gen.actions.CasZoekBest" level="debug" additivity="false">
            <AppenderRef ref="I2D160N"/>
        </Logger>
        <Logger name="nn.fliba.gen.actions.CasZoekBestZeroBalancingCashpool" level="debug" additivity="false">
            <AppenderRef ref="I2D160N"/>
        </Logger>
        <Logger name="nn.fliba.gen.actions.CasZoekBestLifeAllerlei" level="debug" additivity="false">
            <AppenderRef ref="I2D160N"/>
        </Logger>
        <Logger name="nn.fliba.gen.procedures.Casf415bVerwerkCodaBetaling" level="debug" additivity="false">
            <AppenderRef ref="I2D160N"/>
        </Logger>
        <Logger name="nn.fliba.gen.batchmanager.CASF415B" level="debug" additivity="false">
            <AppenderRef ref="I2D160N"/>
        </Logger>

        <!-- Root Logger -->
        <Root level="trace">
            <AppenderRef ref="file"/>
            <!-- <AppenderRef ref="SQLLog" /> -->
        </Root>

        <Logger name="com.innowake.genTargeting.PerfStatNew" additivity="false" level="trace">
            <appender-ref ref="SQLLog"/>
        </Logger>
    </Loggers>
</Configuration>
